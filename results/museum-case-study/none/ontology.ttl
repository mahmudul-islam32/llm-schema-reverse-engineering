@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/srev/> a owl:Ontology ;
    rdfs:comment "Extracted by srev from museum_none; review before use." .

:Artist a owl:Class ;
    rdfs:label "artist" ;
    rdfs:comment "table artist" .
:artist_artist_id a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "artist.artist_id" ;
    rdfs:domain :Artist ;
    rdfs:range xsd:integer .
:artist_name a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "artist.name" ;
    rdfs:domain :Artist ;
    rdfs:range xsd:string .
:artist_birth_year a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "artist.birth_year" ;
    rdfs:domain :Artist ;
    rdfs:range xsd:integer .
:artist_nationality a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "artist.nationality" ;
    rdfs:domain :Artist ;
    rdfs:range xsd:string .
# key artist_id: discovered by srev: UCC (artist.artist_id); uniqueness=1.0
:Artist owl:hasKey ( :artist_artist_id ) .

