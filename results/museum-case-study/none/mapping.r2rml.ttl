@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix : <http://example.org/srev/> .
@prefix map: <http://example.org/srev/mapping#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

map:Artist a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "artist" ] ;
    rr:subjectMap [ rr:template "http://example.org/srev/artist/{artist_id}" ; rr:class :Artist ] ;
    rr:predicateObjectMap [ rr:predicate :artist_artist_id ; rr:objectMap [ rr:column "artist_id" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate :artist_name ; rr:objectMap [ rr:column "name" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate :artist_birth_year ; rr:objectMap [ rr:column "birth_year" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate :artist_nationality ; rr:objectMap [ rr:column "nationality" ; rr:datatype xsd:string ] ] .

map:Exhibition a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "exhibition" ] ;
    rr:subjectMap [ rr:template "http://example.org/srev/exhibition/{exhibition_id}" ; rr:class :Exhibition ] ;
    rr:predicateObjectMap [ rr:predicate :exhibition_exhibition_id ; rr:objectMap [ rr:column "exhibition_id" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate :exhibition_title ; rr:objectMap [ rr:column "title" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate :exhibition_opening ; rr:objectMap [ rr:column "opening" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate :exhibition_venue ; rr:objectMap [ rr:column "venue" ; rr:datatype xsd:string ] ] .

map:Object a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "object" ] ;
    rr:subjectMap [ rr:template "http://example.org/srev/object/{object_id}" ; rr:class :Object ] ;
    rr:predicateObjectMap [ rr:predicate :object_object_id ; rr:objectMap [ rr:column "object_id" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate :object_title ; rr:objectMap [ rr:column "title" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate :object_artist_name ; rr:objectMap [ rr:column "artist_name" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate :object_creation_year ; rr:objectMap [ rr:column "creation_year" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate :object_medium ; rr:objectMap [ rr:column "medium" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate :object_artist ; rr:objectMap [ rr:parentTriplesMap map:Artist ; rr:joinCondition [ rr:child "artist_id" ; rr:parent "artist_id" ] ] ] .

map:Owner a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "owner" ] ;
    rr:subjectMap [ rr:template "http://example.org/srev/owner/{owner_id}" ; rr:class :Owner ] ;
    rr:predicateObjectMap [ rr:predicate :owner_owner_id ; rr:objectMap [ rr:column "owner_id" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate :owner_name ; rr:objectMap [ rr:column "name" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate :owner_owner_type ; rr:objectMap [ rr:column "owner_type" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate :owner_city ; rr:objectMap [ rr:column "city" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate :owner_country ; rr:objectMap [ rr:column "country" ; rr:datatype xsd:string ] ] .

map:ProvenanceEvent a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "provenance_event" ] ;
    rr:subjectMap [ rr:template "http://example.org/srev/provenance_event/{event_id}" ; rr:class :ProvenanceEvent ] ;
    rr:predicateObjectMap [ rr:predicate :provenance_event_event_id ; rr:objectMap [ rr:column "event_id" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate :provenance_event_event_type ; rr:objectMap [ rr:column "event_type" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate :provenance_event_start_year ; rr:objectMap [ rr:column "start_year" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate :provenance_event_object ; rr:objectMap [ rr:parentTriplesMap map:Object ; rr:joinCondition [ rr:child "object_id" ; rr:parent "object_id" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate :provenance_event_owner ; rr:objectMap [ rr:parentTriplesMap map:Owner ; rr:joinCondition [ rr:child "owner_id" ; rr:parent "owner_id" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate :provenance_event_previous_event ; rr:objectMap [ rr:parentTriplesMap map:ProvenanceEvent ; rr:joinCondition [ rr:child "previous_event_id" ; rr:parent "event_id" ] ] ] .

map:Loan a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "loan" ] ;
    rr:subjectMap [ rr:template "http://example.org/srev/exhibition/{exhibition_id}" ] ;
    rr:predicateObjectMap [ rr:predicate :loan ; rr:objectMap [ rr:template "http://example.org/srev/object/{object_id}" ] ] .
